<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GreenSite.SelfTest</AssemblyName>
    <RootNamespace>GreenSite.SelfTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GreenSite.Core\GreenSite.Core.csproj" />
  </ItemGroup>
  <!-- 默认清单是与 WPF 项目共用的唯一数据源，自检需复制到自己的输出目录 -->
  <ItemGroup>
    <Content Include="..\GreenSite\data\**\*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
