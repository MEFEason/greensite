<Window x:Class="GreenSite.Views.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用恢复码解锁"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <StackPanel Margin="26">
        <TextBlock Text="使用恢复码解锁" Style="{StaticResource PageTitleStyle}" FontSize="18" />
        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,18" TextWrapping="Wrap"
                   Text="恢复码为首次设置管理密码时抄录的 25 位代码（5 组，每组 5 位）。解锁后必须立即重设管理密码。若忘记恢复码，只能卸载并重装程序。" />

        <TextBlock Text="恢复码" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" />
        <TextBox x:Name="CodeBox" Style="{StaticResource InputTextBoxStyle}"
                 CharacterCasing="Upper" MaxLength="35"
                 HorizontalContentAlignment="Center" FontFamily="Consolas" />
        <TextBlock Text="格式：XXXXX-XXXXX-XXXXX-XXXXX-XXXXX（短横线可省略，字母不区分大小写）"
                   Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0"
                   Visibility="Collapsed" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />
        <TextBlock x:Name="CooldownText" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="OkButton" Content="解锁" Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
