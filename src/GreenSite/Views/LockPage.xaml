<UserControl x:Class="GreenSite.Views.LockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackground}">
        <Border Style="{StaticResource CardBorderStyle}" Width="430" Padding="30"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="GreenSite" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                <TextBlock Text="网站访问控制" Style="{StaticResource MutedTextStyle}"
                           Margin="0,4,0,22" HorizontalAlignment="Center" />

                <!-- 首次运行：设置管理密码 -->
                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <TextBlock Text="首次使用 · 设置管理密码" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="管理密码用于解锁配置与敏感操作，至少 8 位。忘记时可用恢复码解锁，请牢记密码并抄录恢复码。"
                               Style="{StaticResource MutedTextStyle}" Margin="0,8,0,16" TextWrapping="Wrap" />
                    <TextBlock Text="新密码" Style="{StaticResource BodyTextStyle}" />
                    <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource InputPasswordBoxStyle}"
                                 Margin="0,4,0,10" />
                    <TextBlock Text="确认新密码" Style="{StaticResource BodyTextStyle}" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource InputPasswordBoxStyle}"
                                 Margin="0,4,0,0" />
                    <TextBlock x:Name="SetupErrorText" Style="{StaticResource BodyTextStyle}"
                               Margin="0,10,0,0" Visibility="Collapsed" FontWeight="SemiBold" />
                    <Button x:Name="SetupButton" Content="设置密码并开启保护" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" Click="Setup_Click" />
                </StackPanel>

                <!-- 之后启动：输入密码解锁 -->
                <StackPanel x:Name="UnlockPanel" Visibility="Collapsed">
                    <TextBlock Text="输入管理密码以解锁" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="解锁成功后保护将自动开启。"
                               Style="{StaticResource MutedTextStyle}" Margin="0,8,0,16" />
                    <TextBlock Text="管理密码" Style="{StaticResource BodyTextStyle}" />
                    <PasswordBox x:Name="UnlockPasswordBox" Style="{StaticResource InputPasswordBoxStyle}"
                                 Margin="0,4,0,0" />
                    <TextBlock x:Name="UnlockErrorText" Style="{StaticResource BodyTextStyle}"
                               Margin="0,10,0,0" Visibility="Collapsed" FontWeight="SemiBold" />
                    <TextBlock x:Name="CooldownText" Style="{StaticResource MutedTextStyle}"
                               Margin="0,6,0,0" Visibility="Collapsed" />
                    <Button x:Name="UnlockButton" Content="解锁" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" Click="Unlock_Click" />
                    <Button x:Name="ForgotPasswordButton" Content="忘记管理密码？"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" Click="ForgotPassword_Click" />
                </StackPanel>

                <!-- 恢复码解锁后：强制重设管理密码 -->
                <StackPanel x:Name="ResetPanel" Visibility="Collapsed">
                    <TextBlock Text="重设管理密码" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="你已使用恢复码解锁。为保障安全，请设置新的管理密码后再进入主界面。"
                               Style="{StaticResource MutedTextStyle}" Margin="0,8,0,16" TextWrapping="Wrap" />
                    <TextBlock Text="新密码" Style="{StaticResource BodyTextStyle}" />
                    <PasswordBox x:Name="ResetNewPasswordBox" Style="{StaticResource InputPasswordBoxStyle}"
                                 Margin="0,4,0,10" />
                    <TextBlock Text="确认新密码" Style="{StaticResource BodyTextStyle}" />
                    <PasswordBox x:Name="ResetConfirmPasswordBox" Style="{StaticResource InputPasswordBoxStyle}"
                                 Margin="0,4,0,0" />
                    <TextBlock x:Name="ResetErrorText" Style="{StaticResource BodyTextStyle}"
                               Margin="0,10,0,0" Visibility="Collapsed" FontWeight="SemiBold" />
                    <Button x:Name="ResetButton" Content="确认重设" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" Click="Reset_Click" />
                </StackPanel>

                <!-- 恢复码展示（仅显示一次，由调用方传入文本后显示） -->
                <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
                    <TextBlock Text="请抄录恢复码（仅显示这一次）" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox x:Name="RecoveryCodeBox" Style="{StaticResource InputTextBoxStyle}"
                             FontFamily="Consolas, Courier New, monospace" FontSize="20" FontWeight="SemiBold"
                             IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Center"
                             IsInactiveSelectionHighlightEnabled="True" Margin="0,12,0,0" />
                    <TextBlock Text="忘记管理密码时可用它解锁；请离线保管，不要拍照上传。"
                               Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <Button x:Name="RecoveryConfirmButton" Content="我已抄录，开启保护" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" Click="RecoveryConfirm_Click" />
                </StackPanel>

                <Border Style="{StaticResource DividerStyle}" />
                <Button x:Name="ExitButton" Content="退出程序"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,12"
                        HorizontalAlignment="Stretch" Click="ExitButton_Click" />
                <TextBlock Text="配置经管理密码加密保存；忘记密码可用恢复码解锁；恢复码也忘记只能卸载重装。"
                           Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
