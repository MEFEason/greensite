<UserControl x:Class="GreenSite.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="关于 GreenSite" Style="{StaticResource PageTitleStyle}" />

            <!-- 产品与版本 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,12">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="LogoImage" Width="72" Height="72" Stretch="Uniform"
                           Margin="0,0,18,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GreenSite" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="VersionText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 许可 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="许可与授权" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0"
                               Text="本软件采用 FSL-1.1-ALv2（Functional Source License 1.1，附带 Apache-2.0 授权）发布。" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                               Text="自对应版本发布之日起满 2 年后，该版本自动转为 Apache-2.0 开源许可证。" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="NOTICE" Margin="0,0,8,0" Click="OpenNotice_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="THIRD_PARTY_LICENSES" Margin="0,0,8,0" Click="OpenThirdParty_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="LICENSE" Click="OpenLicense_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 设计致谢 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="设计致谢" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0"
                               Text="界面卡片式布局与交互设计借鉴自开源桌面应用项目 ClassIsland，谨此致谢。GreenSite 为完全独立的项目，不以其名义发布，不使用其名称与 Logo 作为自身标识，与其无任何关联，也不代表其立场。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
