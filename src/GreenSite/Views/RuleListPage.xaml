<UserControl x:Class="GreenSite.Views.RuleListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题与编辑锁状态 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="限制列表" DockPanel.Dock="Left"
                       Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LockStateText" Text="已锁定" Style="{StaticResource MutedTextStyle}"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Button x:Name="RelockButton" Content="重新锁定" Click="Relock_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </DockPanel>

        <!-- 工具条 -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox x:Name="CurrentGroupCombo" Width="150" Margin="0,0,8,6"
                      Style="{StaticResource InputComboBoxStyle}" DisplayMemberPath="Name" />
            <Button Content="新建组" Margin="0,0,8,6" Click="NewGroup_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="重命名" Margin="0,0,8,6" Click="RenameGroup_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="删除组" Margin="0,0,8,6" Click="DeleteGroup_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="添加规则" Margin="0,0,8,6" Click="AddRule_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="导入默认分组" Margin="0,0,8,6" Click="ImportDefault_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <TextBlock Text="搜索" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"
                       Margin="8,0,6,6" />
            <TextBox x:Name="SearchBox" Width="170" Margin="0,0,0,6"
                     Style="{StaticResource InputTextBoxStyle}" TextChanged="SearchBox_TextChanged" />
        </WrapPanel>

        <!-- 白名单优先说明 -->
        <TextBlock Grid.Row="2" Margin="0,0,0,10" Style="{StaticResource MutedTextStyle}"
                   Text="同值同时存在于黑白名单时：白名单优先，将始终放行。有效规则 = 组开关 ∧ 单条开关。" />

        <!-- 添加规则内联面板 -->
        <Border x:Name="AddRulePanel" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,12"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="添加规则" Style="{StaticResource SectionTitleStyle}" />
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="目标组" Style="{StaticResource BodyTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="AddGroupCombo" Width="170" Margin="0,0,14,6"
                              Style="{StaticResource InputComboBoxStyle}" DisplayMemberPath="Name" />
                    <TextBlock Text="类型" Style="{StaticResource BodyTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="AddTypeCombo" Width="200" Margin="0,0,0,6" SelectedIndex="0"
                              Style="{StaticResource InputComboBoxStyle}">
                        <ComboBoxItem Content="域名" />
                        <ComboBoxItem Content="网址（仅明文 HTTP 生效）" />
                    </ComboBox>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="域名/网址" Style="{StaticResource BodyTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="AddValueBox" Width="260" Margin="0,0,14,6"
                             Style="{StaticResource InputTextBoxStyle}" />
                    <TextBlock Text="备注" Style="{StaticResource BodyTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="AddNoteBox" Width="170" Margin="0,0,0,6"
                             Style="{StaticResource InputTextBoxStyle}" />
                </WrapPanel>
                <TextBlock x:Name="AddErrorText" Style="{StaticResource BodyTextStyle}"
                           Margin="0,6,0,0" Visibility="Collapsed" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="取消" Margin="0,0,8,0" Click="AddCancel_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="确定" Click="AddConfirm_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 分组卡片列表（由 code-behind 动态生成）-->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel" />
        </ScrollViewer>
    </Grid>
</UserControl>
