<UserControl x:Class="GreenSite.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="以下敏感操作每次都需单独验证管理密码。"
                       Style="{StaticResource MutedTextStyle}" Margin="0,6,0,18" />

            <!-- 常规 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}" />

                    <CheckBox x:Name="AutoStartCheck" Content="开机自动启动（仅写入当前用户，无需管理员权限）"
                              Margin="0,12,0,0" Style="{StaticResource SwitchCheckBoxStyle}"
                              Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                    <TextBlock Text="自启命令：GreenSite.exe --minimized"
                               Style="{StaticResource MutedTextStyle}" Margin="22,2,0,0" />

                    <CheckBox x:Name="NotifyCheck" Content="拦截时显示托盘通知（同域 30 秒节流）"
                              Margin="0,12,0,0" Style="{StaticResource SwitchCheckBoxStyle}"
                              Checked="Notify_Changed" Unchecked="Notify_Changed" />

                    <Border Style="{StaticResource DividerStyle}" />

                    <TextBlock Text="主题" Style="{StaticResource BodyTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="ThemeLightRadio" Content="浅色" GroupName="ThemeGroup"
                                     Margin="0,0,16,0" Foreground="{DynamicResource TextPrimary}"
                                     Checked="Theme_Changed" />
                        <RadioButton x:Name="ThemeDarkRadio" Content="深色" GroupName="ThemeGroup"
                                     Foreground="{DynamicResource TextPrimary}" Checked="Theme_Changed" />
                    </StackPanel>

                    <Border Style="{StaticResource DividerStyle}" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="日志保留天数" Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="RetentionBox" Width="70" Margin="10,0,8,0"
                                 Style="{StaticResource InputTextBoxStyle}" />
                        <Button Content="应用" Click="RetentionApply_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 网络与加速器 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="网络与加速器" Style="{StaticResource SectionTitleStyle}" />
                    <CheckBox x:Name="FollowUpstreamCheck" Content="检测到系统代理（加速器）时，非限制域名自动跟随其上游"
                              Margin="0,12,0,0" Foreground="{DynamicResource TextPrimary}"
                              Checked="FollowUpstream_Changed" Unchecked="FollowUpstream_Changed" />
                    <TextBlock Text="开启后，白名单与其它域名走加速器代理通道，拦截仍对黑名单 100% 生效；关闭则一律直连。修改后 PAC 立即重建刷新。"
                               Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 白名单生效时段 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="白名单生效时段" Style="{StaticResource SectionTitleStyle}" />
                    <CheckBox x:Name="AllowScheduleCheck" Content="仅在指定时段内放行白名单域名（24 小时制）"
                              Margin="0,12,0,0" Style="{StaticResource SwitchCheckBoxStyle}"
                              Checked="AllowSchedule_Changed" Unchecked="AllowSchedule_Changed" />
                    <TextBlock Text="启用后，白名单只在下列时段生效；时段外自动失效并回退到常规拦截判定（命中黑名单则拦截）。未启用或列表为空时白名单全天生效。支持跨午夜时段，例如 22:00–06:00。此设置与白名单分组开关、单条开关同时生效。"
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />

                    <StackPanel x:Name="ScheduleRows" Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="AddWindowButton" Content="添加时段" Click="AddWindow_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="ApplyScheduleButton" Content="保存时段设置" Click="ApplySchedule_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="ScheduleError" Style="{StaticResource BodyTextStyle}"
                               Margin="0,8,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource WarnForeground}" />
                    <TextBlock x:Name="ScheduleSummary" Style="{StaticResource MutedTextStyle}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 窗口与退出 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="窗口与退出" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="关闭窗口时" Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="CloseHideRadio" Content="最小化到托盘（保护继续）" GroupName="CloseAction"
                                     Margin="0,0,16,0" Foreground="{DynamicResource TextPrimary}" Checked="CloseAction_Changed" />
                        <RadioButton x:Name="CloseExitRadio" Content="退出程序（停止拦截，需密码）" GroupName="CloseAction"
                                     Foreground="{DynamicResource TextPrimary}" Checked="CloseAction_Changed" />
                    </StackPanel>
                    <TextBlock Text="选择「退出程序」时，关闭主窗口会先说明后果并验证管理密码后停止拦截；锁定页与首启页可直接退出（此时尚无拦截，无需密码）。"
                               Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 安全 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="安全与保护" Style="{StaticResource SectionTitleStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="修改管理密码" Click="ChangePwd_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="关闭保护" Click="CloseProtection_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="退出程序" Click="Exit_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="关闭保护仅解除拦截、进程保留；退出程序会停止拦截并结束进程（只还原 PAC 地址，不影响加速器设置）。"
                               Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />

                    <!-- 修改密码面板：原密码由统一门禁验证，此处输入新密码两次 -->
                    <Border x:Name="ChangePwdPanel" Visibility="Collapsed" Margin="0,14,0,0"
                            Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="设置新管理密码（至少 8 位）"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="新密码" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,4" />
                            <PasswordBox x:Name="NewPwdBox" Style="{StaticResource InputPasswordBoxStyle}" />
                            <TextBlock Text="确认新密码" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,4" />
                            <PasswordBox x:Name="ConfirmPwdBox" Style="{StaticResource InputPasswordBoxStyle}" />
                            <TextBlock x:Name="ChangePwdError" Style="{StaticResource BodyTextStyle}"
                                       Margin="0,8,0,0" Visibility="Collapsed" FontWeight="SemiBold" />
                            <Button Content="确认修改" Margin="0,12,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ChangePwdConfirm_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DividerStyle}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="重新生成恢复码" Click="RegenRecovery_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="生成新的一次性恢复码并显示一次，请立即抄录；旧恢复码随即失效。操作前需验证管理密码。"
                               Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
