<Window x:Class="GreenSite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GreenSite · 网站访问控制"
        Width="980" Height="660"
        MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="{DynamicResource WindowBackground}">
    <Grid>
        <!-- 冷启动锁定视图 -->
        <Grid x:Name="LockView" Background="{DynamicResource WindowBackground}">
            <ContentControl x:Name="LockHost" />
        </Grid>

        <!-- 解锁后的主界面 -->
        <Grid x:Name="MainView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrushLight}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,20,14,10">
                        <TextBlock Text="GreenSite" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="网站访问控制" Margin="0,2,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Style="{StaticResource DividerStyle}" Margin="10,4" />

                    <StackPanel x:Name="NavPanel" DockPanel.Dock="Top" Margin="6,6,6,6">
                        <Button x:Name="NavDashboard" Content="状态总览" Tag="dashboard"
                                Style="{StaticResource NavButtonActiveStyle}" Click="Nav_Click" />
                        <Button x:Name="NavBlock" Content="限制列表" Tag="block"
                                Style="{StaticResource NavButtonStyle}" Click="Nav_Click" />
                        <Button x:Name="NavAllow" Content="白名单" Tag="allow"
                                Style="{StaticResource NavButtonStyle}" Click="Nav_Click" />
                        <Button x:Name="NavLog" Content="拦截日志" Tag="log"
                                Style="{StaticResource NavButtonStyle}" Click="Nav_Click" />
                        <Button x:Name="NavSettings" Content="设置" Tag="settings"
                                Style="{StaticResource NavButtonStyle}" Click="Nav_Click" />
                        <Button x:Name="NavAbout" Content="关于" Tag="about"
                                Style="{StaticResource NavButtonStyle}" Click="Nav_Click" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,18" VerticalAlignment="Bottom">
                        <Border x:Name="StatusPill" Style="{StaticResource PillBorderStyle}"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="StatusPillText" Text="保护中"
                                       Style="{StaticResource PillTextStyle}" />
                        </Border>
                        <TextBlock x:Name="TodayBlockedText" Text="今日拦截 0 次" Margin="0,10,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                        <!-- 状态栏快捷开关：功能与托盘菜单一致，无需每次回到托盘切换防护 -->
                        <Button x:Name="ProtectionToggleButton" Content="关闭防护"
                                Margin="0,12,0,0" MinWidth="132" Padding="10,6"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ProtectionToggle_Click"
                                ToolTip="开启或关闭防护（需管理密码）；与托盘菜单一致" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧内容 -->
            <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="20" />
        </Grid>
    </Grid>
</Window>
