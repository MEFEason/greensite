<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Guard</AssemblyName>
    <RootNamespace>GreenSite.Guard</RootNamespace>
    <ApplicationIcon>..\GreenSite\assets\app.ico</ApplicationIcon>
    <!-- 版本号由 build.ps1 注入，与主程序一致 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GreenSite.Core\GreenSite.Core.csproj" />
  </ItemGroup>
</Project>
